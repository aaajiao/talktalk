    "%@ 正在使用实体麦克风，TalkTalk 无法在翻译时关闭原声。请在 %@ 的音频设置里选 TalkTalk Mic。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is using a physical microphone, so TalkTalk cannot mute original audio during translation. Select TalkTalk Mic in %@ audio settings."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在使用实体麦克风，TalkTalk 无法在翻译时关闭原声。请在 %@ 的音频设置里选 TalkTalk Mic。"
          }
        }
      }
    },
    "%@ 正在用 %@：在 %@ 里选 TalkTalk Mic": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is using %@: select TalkTalk Mic in %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 正在用 %@：在 %@ 里选 TalkTalk Mic"
