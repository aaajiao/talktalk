{
  "sourceLanguage": "zh-Hans",
  "strings": {
    " 等 %@ 项": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " and other issues (%@ total)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": " 等 %@ 项"
          }
        }
      }
    },
    "%@\n\n已保留恢复记录。请在“系统设置 › 声音 › 输入”中检查并选择实体麦克风，也可下次启动 TalkTalk 后重试。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\nThe recovery record has been kept. In System Settings › Sound › Input, check and select a physical microphone, or try again the next time you open TalkTalk."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@\n\n已保留恢复记录。请在“系统设置 › 声音 › 输入”中检查并选择实体麦克风，也可下次启动 TalkTalk 后重试。"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
