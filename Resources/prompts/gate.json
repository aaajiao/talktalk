{
  "version": 2,
  "comment": "TargetTextGate (ARCHITECTURE.md §5.4): meta-talk and refusal patterns, matched case-insensitively against the whole first line (ICU regex). Fillers: a line made only of these words and punctuation is rejected.",
  "meta": [
    "^here(?:'s| is) (?:the|my|your) translation\\b",
    "^(?:the )?translation\\s*:",
    "^\\(?\\s*no (?:content|text|translation)\\b",
    "\\(no content\\)",
    "^hier ist (?:die|meine) übersetzung\\b",
    "^übersetzung\\s*:",
    "^\\(?\\s*kein (?:inhalt|text)\\b",
    "^i (?:cannot|can't|can not|am unable to|'m unable to)\\b",
    "^(?:i'm|i am) sorry\\b",
    "^sorry,? (?:i|but)\\b",
    "^as an ai\\b",
    "^ich kann (?:das|dies|diesen|diese|hier|leider)?\\s*(?:nicht|keine)\\b",
    "^es tut mir leid\\b",
    "^(?:note|hinweis|anmerkung)\\s*:",
    "^\\[[^\\]]*\\]$",
    "^\\([^)]*\\)$",
    "^<(?!none>)[^>]*>$",
    "^(?:以下是|这是)(?:中文)?(?:翻译|译文)",
    "^(?:翻译|译文)\\s*[:：]",
    "^(?:没有|无)(?:可供|需要)?(?:翻译的)?(?:内容|文本)[。.!！]?$",
    "^作为(?:一个|一名)?(?:AI|人工智能)",
    "^(?:voici|voilà) (?:la|ma|votre) traduction\\b",
    "^(?:la )?traduction\\s*:",
    "^je ne peux pas (?:traduire|fournir une traduction)\\b",
    "^en tant qu['’](?:une? )?(?:ia|intelligence artificielle)\\b",
    "^(?:aucun|pas de) (?:contenu|texte|traduction)\\b"
  ],
  "fillers": {
    "en": ["um", "uh", "er", "erm", "hmm", "hm", "mm", "uhm"],
    "de": ["äh", "ähm", "öh", "hm", "hmm", "mhm"],
    "zh": ["嗯", "啊", "呃", "唔"],
    "fr": ["euh", "heu", "hum", "hmm", "hm"]
  }
}
